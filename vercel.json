{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work/glow",
      "destination": "/_routes/work-glow.html"
    },
    {
      "source": "/work/carenearby",
      "destination": "/_routes/work-carenearby.html"
    },
    {
      "source": "/work/lami-nepal",
      "destination": "/_routes/work-lami-nepal.html"
    },
    {
      "source": "/work",
      "destination": "/_routes/work.html"
    },
    {
      "source": "/what-we-do",
      "destination": "/_routes/what-we-do.html"
    },
    {
      "source": "/about-us",
      "destination": "/_routes/about-us.html"
    },
    {
      "source": "/latest-news",
      "destination": "/_routes/latest-news.html"
    },
    {
      "source": "/contact",
      "destination": "/_routes/contact.html"
    },
    {
      "source": "/ventures",
      "destination": "/_routes/ventures.html"
    },
    {
      "source": "/clients",
      "destination": "/_routes/clients.html"
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/what-we-do",
      "permanent": true
    },
    {
      "source": "/services/:slug",
      "destination": "/what-we-do",
      "permanent": true
    }
  ]
}
